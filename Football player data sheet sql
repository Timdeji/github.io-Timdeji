--17 Write a query to get the number of players for each team grouped by their experience level.

SELECT [Team]
       ,[Exp]
       ,count([NAME ]) AS No_of_players
FROM [dbo].['Football Players Data$']
GROUP BY [Team],[Exp]
ORDER BY [Team],[Exp]



--18 Write a query to find the tallest and shortest players from each college.


WITH cte AS
  (
SELECT *
,Row_number() OVER(PARTITION BY [College] ORDER BY [Inches] DESC) AS tallest_rank
,Row_number() OVER(PARTITION BY [College] ORDER BY [Inches] ASC) AS shortest_rank
FROM [dbo].['Football Players Data$']
      )

SELECT 
      [College]
	 ,[NAME ]
     ,[Inches]
      ,CASE
	  WHEN tallest_rank = '1' THEN 'Tallest'
	  WHEN shortest_rank = '1' THEN 'Shortest'
	  END AS 'Category'
FROM cte
WHERE tallest_rank = '1' OR shortest_rank = '1'
ORDER BY [College]


--19 Write a query to find all players whose weight is above the average weight for their respective position.

SELECT [Year]
       ,[Team]
	   ,[NAME ]
	   ,[No#]
	   ,[Pos]
	   ,[Ht]
	   ,[Wt]
	   ,[Age]
	   ,[Exp]
	   ,[College]
	   ,[FirstName]
	   ,[LastName]
	   ,[Ft]
	   ,[In]
	   ,[Inches]
	   ,[NumGrp]
	   ,Average_teamweight
FROM 
    (SELECT [Year]
       ,[Team]
	   ,[NAME ]
	   ,[No#]
	   ,[Pos]
	   ,[Ht]
	   ,[Wt]
	   ,[Age]
	   ,[Exp]
	   ,[College]
	   ,[FirstName]
	   ,[LastName]
	   ,[Ft]
	   ,[In]
	   ,[Inches]
	   ,[NumGrp]
	   ,AVG([Wt]) OVER(PARTITION BY [Pos]) AS Average_teamweight
FROM [dbo].['Football Players Data$']
       ) AS Subquery
WHERE [Wt] > Average_teamweight


--20 Write a query to calculate the percentage of players in each position for every team.


WITH cte AS
   (
SELECT *
,COUNT([NAME ]) OVER(PARTITION BY [Pos]) AS no_in_a_position
,COUNT([NAME ]) OVER(PARTITION BY [Team]) AS no_in_a_team
FROM [dbo].['Football Players Data$']
    )
SELECT distinct [Team]
       ,[Pos]
,100*(no_in_a_position) / (no_in_a_team) AS Player_percentage
FROM cte
