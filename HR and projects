--12    Write an SQL query to join the the tables – ‘EmployeeDetails’ and ‘EmployeeSalary’

SELECT d.[EmpId]
	  ,d.[FullName]
	  ,d.[ManagerId]
	  ,d.[DateOfJoining]
	  ,d.[City]
	  ,s.project
	  ,s.Salary
	  ,s.Variable
FROM [dbo].[Employee_Details$] AS d
JOIN [dbo].[Employee_Salary$] AS s
ON d.EmpId = s.EmpId


--13  Write an SQL query to join the the tables – ‘EmployeeDetails’ and ‘EmployeeSalary’ where manager id is 986

SELECT d.[EmpId]
	  ,d.[FullName]
	  ,d.[ManagerId]
	  ,d.[DateOfJoining]
	  ,d.[City]
	  ,s.project
	  ,s.Salary
	  ,s.Variable
FROM [dbo].[Employee_Details$] AS d
JOIN [dbo].[Employee_Salary$] AS s
ON d.EmpId = s.EmpId
where ManagerId = '986'


--14 Write a query to assign project title to projects, project 1 as transformation and Project 2 as Customer experience


SELECT *
	,CASE
	WHEN [Project] = 'P1' THEN 'Transformation'
	WHEN [Project] = 'P2' THEN 'Customer experience'
	ELSE 'Null'
	END AS 'Project Name'
FROM [dbo].[Employee_Salary$]
